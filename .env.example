# ==============================================================================
# AXIVON ONE — Phase 1 Environment Configuration Template
# ==============================================================================
# SAFETY WARNING: Safe placeholder values only. Never commit real credentials.
# ==============================================================================

# Application Environment
NODE_ENV=development
APP_NAME=AXIVON_ONE
APP_PORT=3000
API_PORT=5000
API_PREFIX=/api/v1

# Security & Tokens (PLACEHOLDERS ONLY)
JWT_SECRET=your_jwt_secret_min_32_characters_long_placeholder
JWT_EXPIRES_IN=1h
JWT_REFRESH_SECRET=your_jwt_refresh_secret_min_32_chars_placeholder
JWT_REFRESH_EXPIRES_IN=7d
SESSION_SECRET=your_session_secret_placeholder

# Authentication policy (safe defaults; tune per environment, never commit secrets)
AUTH_EMAIL_VERIFICATION_TTL=24h
AUTH_PASSWORD_RESET_TTL=30m
AUTH_MAX_FAILED_LOGINS=5
AUTH_LOCKOUT_DURATION=15m
AUTH_ROTATE_REFRESH_TOKENS=true
AUTH_MIN_PASSWORD_LENGTH=8
AUTH_MAX_PASSWORD_LENGTH=128
AUTH_RATE_LIMIT_WINDOW=15m
AUTH_RATE_LIMIT_LOGIN_IP=20
AUTH_RATE_LIMIT_LOGIN_EMAIL=10
AUTH_RATE_LIMIT_REGISTER_IP=10
AUTH_RATE_LIMIT_FORGOT_IP=10
AUTH_RATE_LIMIT_FORGOT_EMAIL=5
AUTH_RATE_LIMIT_RESET_IP=10
AUTH_RATE_LIMIT_VERIFY_IP=20

# Database Configuration (PLACEHOLDERS ONLY)
DB_HOST=localhost
DB_PORT=5432
DB_NAME=axivon_one_dev
DB_USER=axivon_user
DB_PASSWORD=your_secure_db_password_placeholder
DB_SSL=false

# Redis / Cache (PLACEHOLDERS ONLY)
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# File Storage Configuration (Local / S3 Compatible)
STORAGE_PROVIDER=local
STORAGE_LOCAL_PATH=./uploads
STORAGE_S3_BUCKET=axivon-storage-placeholder
STORAGE_S3_REGION=us-east-1

# Logging & Monitoring
LOG_LEVEL=debug
ENABLE_AUDIT_LOGS=true
ENABLE_SWAGGER_DOCS=true
