# ==============================================================================
# AXIVON ONE — Phase 1 Environment Configuration Template
# ==============================================================================
# SAFETY WARNING: Safe placeholder values only. Never commit real credentials.
# ==============================================================================

# Application Environment
NODE_ENV=development
APP_NAME=AXIVON_ONE
APP_PORT=3000
API_PORT=5000
API_PREFIX=/api/v1

# Security & Tokens (PLACEHOLDERS ONLY)
JWT_SECRET=your_jwt_secret_min_32_characters_long_placeholder
JWT_EXPIRES_IN=1h
JWT_REFRESH_SECRET=your_jwt_refresh_secret_min_32_chars_placeholder
JWT_REFRESH_EXPIRES_IN=7d
SESSION_SECRET=your_session_secret_placeholder

# Database Configuration (PLACEHOLDERS ONLY)
DB_HOST=localhost
DB_PORT=5432
DB_NAME=axivon_one_dev
DB_USER=axivon_user
DB_PASSWORD=your_secure_db_password_placeholder
DB_SSL=false

# Redis / Cache (PLACEHOLDERS ONLY)
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# File Storage Configuration (Local / S3 Compatible)
STORAGE_PROVIDER=local
STORAGE_LOCAL_PATH=./uploads
STORAGE_S3_BUCKET=axivon-storage-placeholder
STORAGE_S3_REGION=us-east-1

# Logging & Monitoring
LOG_LEVEL=debug
ENABLE_AUDIT_LOGS=true
ENABLE_SWAGGER_DOCS=true
