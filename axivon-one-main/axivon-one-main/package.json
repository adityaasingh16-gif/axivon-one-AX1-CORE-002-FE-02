{
  "name": "axivon-one",
  "version": "1.0.0-phase1.0",
  "description": "AXIVON ONE — Modular & Reusable Software Platform by Axivon Technologies",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*",
    "modules/core/*"
  ],
  "scripts": {
    "build": "npm run build --workspaces --if-present",
    "lint": "npm run lint --workspaces --if-present",
    "test": "npm run test --workspaces --if-present",
    "test:unit": "echo 'Unit tests placeholder'",
    "test:integration": "echo 'Integration tests placeholder'",
    "test:e2e": "echo 'E2E tests placeholder'",
    "dev": "echo 'Dev placeholder'",
    "typecheck": "tsc --noEmit"
  },
  "keywords": [
    "axivon",
    "axivon-one",
    "modular-platform",
    "reusable-architecture",
    "typescript"
  ],
  "author": "Axivon Technologies",
  "license": "UNLICENSED",
  "devDependencies": {
    "@types/node": "^20.11.24",
    "typescript": "^5.3.3"
  }
}
