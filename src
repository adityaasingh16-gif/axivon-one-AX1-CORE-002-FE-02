// components/UIStates.tsx
//
// Shared loading / empty / error state components. Each is built to pass an
// accessibility review: status/error text is announced via aria-live,
// spinners are aria-hidden (decorative), and empty/error states are real
// focusable landmarks rather than plain divs so screen reader users land
// somewhere meaningful.

import type { ReactNode } from "react";

export function LoadingState({ label = "Loading…" }: { label?: string }) {
  return (
    <div role="status" aria-live="polite" className="flex items-center gap-3 py-10 text-sm text-[#8B99B3]">
      <span
        aria-hidden="true"
        className="h-4 w-4 animate-spin rounded-full border-2 border-[#3A4A66] border-t-[#5B6EF5]"
      />
      <span>{label}</span>
    </div>
  );
}

export function EmptyState({
  title,
  description,
  action,
}: {
  title: string;
  description?: string;
  action?: ReactNode;
}) {
  return (
    <div
      role="region"
      aria-label={title}
      tabIndex={-1}
      className="flex flex-col items-center gap-2 rounded-lg border border-dashed border-[#22314A] py-14 text-center"
    >
      <p className="text-sm font-medium text-[#F4F6FA]">{title}</p>
      {description && <p className="max-w-sm text-sm text-[#8B99B3]">{description}</p>}
      {action && <div className="mt-2">{action}</div>}
    </div>
  );
}

export function ErrorState({
  message,
  onRetry,
}: {
  message: string;
  onRetry?: () => void;
}) {
  return (
    <div
      role="alert"
      aria-live="assertive"
      tabIndex={-1}
      className="flex flex-col items-center gap-3 rounded-lg border border-[#5A2A31] bg-[#1E1216] py-10 text-center"
    >
      <p className="text-sm font-medium text-[#F2A0A6]">Something went wrong</p>
      <p className="max-w-sm text-sm text-[#C98D92]">{message}</p>
      {onRetry && (
        <button
          onClick={onRetry}
          className="rounded-md border border-[#5A2A31] px-3 py-1.5 text-sm text-[#F2A0A6] hover:bg-[#2A171C]"
        >
          Try again
        </button>
      )}
    </div>
  );
}

// Field-level inline error, used under form inputs. `id` must match the
// input's aria-describedby so screen readers announce it on focus.
export function FieldError({ id, message }: { id: string; message?: string }) {
  if (!message) return null;
  return (
    <p id={id} role="alert" className="mt-1 text-xs text-[#F2A0A6]">
      {message}
    </p>
  );
}
